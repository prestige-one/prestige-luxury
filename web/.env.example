SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=it@prestigeone.ae
# Use your Brevo SMTP key here (SMTP & API > SMTP), not a REST API key.
SMTP_PASSWORD=replace_with_brevo_smtp_key
# The sender must be verified in your Brevo account.
LEAD_FROM_EMAIL=it@prestigeone.ae
LEAD_TO_EMAIL=sumith@prestigeone.ae

# Optional: comma-separated copy recipients for every enquiry form.
LEAD_CC_EMAIL=
